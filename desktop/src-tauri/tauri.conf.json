{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MakeTech Data Extractor",
  "version": "0.1.0",
  "identifier": "com.maketech.dataextractor",
  "build": {
    "beforeDevCommand": "cd ../../frontend && npm run dev -- --hostname 127.0.0.1 --port 3000",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "MakeTech Data Extractor",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "resources": {
      "../../dist/maketech-backend.exe": "bin/maketech-backend.exe"
    }
  }
}
